        "import pandas as pd\n",
        "import numpy as np\n",
        "import bisect\n",
        "import sys\n",
        "\n",
        "# Detect if running in Colab\n",
        "is_colab = \"google.colab\" in sys.modules\n",
        "\n",
        "if is_colab:\n",
        "    from google.colab import files\n",
        "    print(\"🔁 Running in Google Colab — please upload your CSV file.\")\n",
        "    uploaded = files.upload()\n",
        "    filename = list(uploaded.keys())[0]\n",
        "else:\n",
        "    print(\"🔁 Running locally — please make sure the file exists in your working directory.\")\n",
        "    filename = \"Nifty 5pct High Low Swings.csv\"  # ⬅️ Change this if needed\n",
        "\n",
        "# Load and clean the data\n",
        "df = pd.read_csv(filename, parse_dates=[\"Date\"])\n",
        "df.columns = [c.strip() for c in df.columns]\n",
        "\n",
        "for col in [\"Open\", \"High\", \"Low\", \"Close\"]:\n",
        "    df[col] = df[col].astype(str).str.replace(\",\", \"\", regex=False)\n",
        "    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "\n",
        "df.dropna(subset=[\"High\", \"Low\"], inplace=True)\n",
        "\n",
        "# Detect swings using High/Low and threshold\n",
        "def detect_swings(dates, highs, lows, threshold=0.05):\n",
        "    dates = np.array(dates)\n",
        "    highs = np.array(highs, dtype=float)\n",
        "    lows = np.array(lows, dtype=float)\n",
        "    n = len(highs)\n",
        "    swings = []\n",
        "    i = 0\n",
        "    mode = 'looking_for_low'\n",
        "    extreme_price = lows[i]\n",
        "    extreme_index = i\n",
        "    for k in range(i + 1, n):\n",
        "        high = highs[k]\n",
        "        low = lows[k]\n",
        "        if mode == 'looking_for_top':\n",
        "            if high > extreme_price:\n",
        "                extreme_price = high\n",
        "                extreme_index = k\n",
        "            elif low < extreme_price * (1 - threshold):\n",
        "                swings.append((dates[extreme_index], extreme_price, \"Top\"))\n",
        "                mode = 'looking_for_low'\n",
        "                extreme_price = low\n",
        "                extreme_index = k\n",
        "        elif mode == 'looking_for_low':\n",
        "            if low < extreme_price:\n",
        "                extreme_price = low\n",
        "                extreme_index = k\n",
        "            elif high > extreme_price * (1 + threshold):\n",
        "                swings.append((dates[extreme_index], extreme_price, \"Low\"))\n",
        "                mode = 'looking_for_top'\n",
        "                extreme_price = high\n",
        "                extreme_index = k\n",
        "    return pd.DataFrame(swings, columns=[\"Date\", \"Price\", \"Type\"])\n",
        "\n",
        "swing_df = detect_swings(df[\"Date\"], df[\"High\"], df[\"Low\"], threshold=0.05)\n",
        "swing_df.sort_values(\"Date\", inplace=True)\n",
        "swing_df.reset_index(drop=True, inplace=True)\n",
        "\n",
        "# Generate custom cycle levels\n",
        "def generate_cycle_levels(start=2.0, max_price=30000):\n",
        "    levels = [start]\n",
        "    current = start\n",
        "    while current < max_price:\n",
        "        current = (np.sqrt(current) + 0.25) ** 2\n",
        "        levels.append(current)\n",
        "    return levels\n",
        "\n",
        "def get_cycle_fraction(price, levels):\n",
        "    if price <= levels[0]:\n",
        "        return 0.0\n",
        "    if price >= levels[-1]:\n",
        "        return (len(levels) - 1) / 8.0\n",
        "    idx = bisect.bisect_right(levels, price)\n",
        "    lower = levels[idx - 1]\n",
        "    upper = levels[idx]\n",
        "    interval_fraction = (price - lower) / (upper - lower)\n",
        "    return (idx - 1 + interval_fraction) / 8.0\n",
        "\n",
        "# Apply cycle fractions\n",
        "max_price = swing_df[\"Price\"].max()\n",
        "cycle_levels = generate_cycle_levels(max_price=max_price * 2)\n",
        "swing_df[\"CycleFraction\"] = swing_df[\"Price\"].apply(lambda p: get_cycle_fraction(p, cycle_levels))\n",
        "\n",
        "# Compute cycle deltas between swings\n",
        "rows = []\n",
        "for i in range(1, len(swing_df)):\n",
        "    prev = swing_df.iloc[i - 1]\n",
        "    curr = swing_df.iloc[i]\n",
        "    delta = curr[\"CycleFraction\"] - prev[\"CycleFraction\"]\n",
        "    direction = \"-\" if prev[\"Type\"] == \"Top\" and curr[\"Type\"] == \"Low\" else \"+\"\n",
        "    delta_signed = delta if direction == \"+\" else -delta\n",
        "    full_cycles = int(abs(delta_signed))\n",
        "    degree_delta = round((abs(delta_signed) % 1) * 360, 2)\n",
        "    rows.append({\n",
        "        \"FromDate\": prev[\"Date\"],\n",
        "        \"ToDate\": curr[\"Date\"],\n",
        "        \"FromPrice\": prev[\"Price\"],\n",
        "        \"ToPrice\": curr[\"Price\"],\n",
        "        \"FromType\": prev[\"Type\"],\n",
        "        \"ToType\": curr[\"Type\"],\n",
        "        \"CycleDelta\": round(delta_signed, 3),\n",
        "        \"Direction\": direction,\n",
        "        \"FullCycles\": full_cycles,\n",
        "        \"DegreeDelta\": degree_delta\n",
        "    })\n",
        "\n",
        "# Final DataFrame\n",
        "cycle_diff_df = pd.DataFrame(rows)\n",
        "\n",
        "# Save and download or export\n",
        "output_name = \"Nifty_5pct_Cycle_Diff.csv\"\n",
        "cycle_diff_df.to_csv(output_name, index=False)\n",
        "\n",
        "if is_colab:\n",
        "    files.download(output_name)\n",
        "else:\n",
        "    print(f\"✅ File saved locally as: {output_name}\")\n"
